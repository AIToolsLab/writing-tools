{
	"name": "thoughtful-ai-app",
	"version": "0.0.1",
	"repository": {
		"type": "git",
		"url": "https://github.com/AIToolsLab/writing-tools"
	},
	"license": "MIT",
	"config": {
		"app_to_debug": "word",
		"app_type_to_debug": "desktop",
		"dev_server_port": 3000
	},
	"scripts": {
		"build": "vite build",
		"build:dev": "vite build --mode development",
		"build:google-docs": "BUILD_TARGET=google-docs vite build",
		"build:google-docs:dev": "BUILD_TARGET=google-docs vite build --mode development",
		"dev-server": "vite",
		"prod-server": "http-server ./dist -p 3000",
		"start": "office-addin-debugging start manifest.xml",
		"start:desktop": "office-addin-debugging start manifest.xml desktop",
		"start:web": "office-addin-debugging start manifest.xml web",
		"stop": "office-addin-debugging stop manifest.xml",
		"validate": "office-addin-manifest validate manifest.xml",
		"validate:prod": "office-addin-manifest validate -p dist/manifest.xml",
		"watch": "vite build --watch --mode development",
		"typecheck": "tsc --noEmit",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"format": "prettier --write \"src/**/*.{js,ts,tsx,json,css,md}\"",
		"format:check": "prettier --check \"src/**/*.{js,ts,tsx,json,css,md}\"",
		"format:file": "prettier --write",
		"lint:file": "eslint --fix",
		"style": "npm run lint && npm run format:check",
		"style:fix": "npm run lint:fix && npm run format",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:build": "node test-build-output.mjs",
		"test:dev-server": "node test-dev-server.mjs"
	},
	"dependencies": {
		"@ai-sdk/openai": "^4.0.30",
		"@lexical/react": "^0.45.0",
		"@posthog/react": "^1.9.0",
		"@react-hook/window-size": "^3.1.1",
		"ai": "^7.0.52",
		"jotai": "^2.12.5",
		"lexical": "^0.45.0",
		"posthog-js": "^1.388.1",
		"react": "^19.2.0",
		"react-dom": "^19.2.0",
		"react-icons": "^5.2.1",
		"react-remark": "^2.1.0",
		"reshaped": "^3.5.3",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.1",
		"@playwright/test": "^1.60",
		"@tailwindcss/postcss": "^4.1.8",
		"@tailwindcss/typography": "^0.5.16",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^24.6.2",
		"@types/office-js": "^1.0.377",
		"@types/office-runtime": "^1.0.35",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@typescript-eslint/eslint-plugin": "^8.0.0",
		"@typescript-eslint/parser": "^8.0.0",
		"@typescript-eslint/utils": "^8.33.1",
		"@vitejs/plugin-react": "^4.7.0",
		"eslint": "^9.0.0",
		"eslint-plugin-office-addins": "^4.0.3",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"globals": "^16.2.0",
		"http-server": "^14.1.1",
		"jsdom": "^26.1.0",
		"office-addin-debugging": "^6.0.3",
		"office-addin-dev-certs": "^1.13.5",
		"office-addin-manifest": "^1.13.6",
		"postcss": "^8.5.23",
		"prettier": "^3.9.6",
		"tailwindcss": "^4.1.8",
		"typescript": "^5.4.2",
		"typescript-eslint": "^8.33.1",
		"vite": "^6.4.3",
		"vitest": "^4.1.8"
	}
}
